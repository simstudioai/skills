{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"types": ["node"]
	},
	"include": ["src/**/*", "scripts/**/*", "vitest.config.ts"],
	"exclude": ["node_modules", "dist"]
}
